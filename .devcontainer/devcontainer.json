{
  "name": "daily-coin workspace",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "overrideCommand": true,
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API (FastAPI)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && (cd frontend && npm ci)",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ]
    }
  }
}
